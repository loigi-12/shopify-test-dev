{% if section.settings.image %}
  <img src="{{ section.settings.image | image_url}}" alt=""/>
{% endif %}

<h1>{{ section.settings.title }}</h1>


{% schema %}
  {
    "name": "New Section",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title"
      }
    ],
    "presets": [
      {
        "name": "New Section"
      }
    ]
  }
{% endschema %}